{
  "name": "places-leaflet",
  "version": "0.0.2",
  "description": "Map provider for Places using Leaflet, with raster maps, custom tile layers, markers, tracks, and overlays.",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src package.json manifest.json versions.json",
    "rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
    "dev": "node esbuild.config.mjs && npm run rename",
    "build": "npm run typecheck && npm run bundle",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "watch": "node esbuild.config.mjs watch",
    "bundle": "node esbuild.config.mjs production && npm run rename",
    "format": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo . --fix",
    "format:check": "node ../../vaultquery-tests/scripts/lint.mjs --format-only --repo ."
  },
  "keywords": [],
  "author": "Bob Stanton",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^2.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "1.14.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "leaflet": "2.0.0-alpha.1",
    "places-shared": "git+https://github.com/bobstanton/places-shared.git#0.0.2"
  },
  "overrides": {
    "typescript": "6.0.3",
    "obsidian": "1.14.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  }
}
